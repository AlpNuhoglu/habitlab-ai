# ─────────────────────────────────────────────────────────────────────────────
# WARNING: every VITE_* value is compiled into the browser bundle and is
# PUBLIC. Never put an API key, private key, or backend secret in this file.
# Backend secrets belong in the repo-root .env, which Vite does not read
# (see envDir/envPrefix in vite.config.ts).
#
# VITE_VAPID_PUBLIC_KEY is the PUBLIC half of the VAPID pair — required in the
# browser by the Web Push spec, safe to ship. The private half lives only in
# the root .env as VAPID_PRIVATE_KEY.
# ─────────────────────────────────────────────────────────────────────────────

VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VITE_ENABLE_TELEMETRY=false
VITE_SW_DEV=false
VITE_RUN_RECONCILIATION_TESTS=false

VITE_GIT_SHA=dev
VITE_HEALTH_PROBE_ENABLED=false
